# PulseMCP Chatbot Configuration
# Copy this file to .env and fill in your API key

# Groq API Key (required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Playwright MCP Server URL (started separately via npx)
PLAYWRIGHT_MCP_URL=http://localhost:9222/mcp

# FastMCP Proxy Server
FASTMCP_PORT=8001
FASTMCP_URL=http://localhost:8001/mcp

# FastAPI Backend
FASTAPI_PORT=8000
