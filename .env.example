# iLumina Chatbot Configuration
# Copy this file to .env and fill in your API keys

# Groq API Key (required for default LLM provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Google Gemini API Key (required for vision / Gemini provider)
GOOGLE_API_KEY=your_google_api_key_here


# Playwright MCP Server URL (started separately via npx)
PLAYWRIGHT_MCP_URL=http://localhost:9222/mcp

# FastMCP Proxy Server
FASTMCP_PORT=8001
FASTMCP_URL=http://localhost:8001/mcp

# FastAPI Backend
FASTAPI_PORT=8000

# Microsoft 365 MCP (optional — for OneDrive integration)
MS365_MCP_CLIENT_ID=your_ms365_client_id_here
MS365_MCP_TENANT_ID=common
# MS365_MCP_CLIENT_SECRET=your_ms365_client_secret_here

# Agent Configuration
MAX_ITERATIONS=10

# Workspace directory for filesystem MCP server (defaults to project root)
# WORKSPACE_DIR=/path/to/your/workspace
